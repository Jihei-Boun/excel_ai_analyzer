{
  "description": "Phase 39F generic VALID dual-side false-fail family (neutral schemas). Expected PASS.",
  "cases": [
    {
      "id": "FF1-rename-rename-join",
      "family": "valid_dual_side",
      "expected_verdict": "pass",
      "prompt": "Compare metric values for side A versus side B and keep both side values visible by entity_id.",
      "source_schemas": {
        "src_a.xlsx": [
          "entity_id",
          "metric"
        ],
        "src_b.xlsx": [
          "entity_id",
          "metric"
        ]
      },
      "plan": {
        "status": "planned",
        "steps": [
          {
            "id": "r_a",
            "op": "rename_columns",
            "inputs": [
              "src_a.xlsx"
            ],
            "output": "a_renamed",
            "params": {
              "mapping": {
                "metric": "metric_a"
              }
            }
          },
          {
            "id": "r_b",
            "op": "rename_columns",
            "inputs": [
              "src_b.xlsx"
            ],
            "output": "b_renamed",
            "params": {
              "mapping": {
                "metric": "metric_b"
              }
            }
          },
          {
            "id": "j",
            "op": "join",
            "inputs": [
              "a_renamed",
              "b_renamed"
            ],
            "output": "final",
            "params": {
              "left_keys": [
                "entity_id"
              ],
              "right_keys": [
                "entity_id"
              ],
              "how": "inner"
            }
          }
        ],
        "final_output": "final",
        "reason": "Rename then join keeps both side metrics.",
        "final_output_requirements": {
          "grain": "entity",
          "required_columns": [
            "entity_id",
            "metric_a",
            "metric_b"
          ],
          "one_row_represents": "one entity with both side metrics",
          "output_roles": [
            {
              "role": "entity_key",
              "columns": [
                "entity_id"
              ]
            },
            {
              "role": "comparison_side",
              "columns": [
                "metric_a"
              ],
              "side_id": "A"
            },
            {
              "role": "comparison_side",
              "columns": [
                "metric_b"
              ],
              "side_id": "B"
            }
          ]
        }
      }
    },
