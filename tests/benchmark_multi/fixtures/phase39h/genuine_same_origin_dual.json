{
  "description": "Phase 39H genuine same-origin partitioned dual-side. Expected PASS. Critical counterexamples to same-origin==invalid.",
  "cases": [
    {
      "id": "GS1",
      "family": "genuine_filter_partition_dual",
      "expected_verdict": "pass",
      "prompt": "Compare value totals for period A versus period B and keep both period totals visible by entity_id.",
      "source_schemas": {
        "data.xlsx": ["entity_id", "period", "value"]
      },
      "plan": {
        "status": "planned",
        "steps": [
          {
            "id": "fA",
            "op": "filter_rows",
            "inputs": ["data.xlsx"],
            "output": "rows_a",
            "params": {
              "conditions": [{"column": "period", "op": "eq", "value": "A"}]
            }
          },
          {
            "id": "fB",
            "op": "filter_rows",
            "inputs": ["data.xlsx"],
            "output": "rows_b",
            "params": {
              "conditions": [{"column": "period", "op": "eq", "value": "B"}]
            }
          },
          {
            "id": "aggA",
            "op": "aggregate",
            "inputs": ["rows_a"],
            "output": "side_a_tbl",
            "params": {
              "group_by": ["entity_id"],
              "metrics": [{"column": "value", "function": "sum", "alias": "side_a"}]
            }
          },
          {
            "id": "aggB",
            "op": "aggregate",
            "inputs": ["rows_b"],
            "output": "side_b_tbl",
            "params": {
              "group_by": ["entity_id"],
              "metrics": [{"column": "value", "function": "sum", "alias": "side_b"}]
            }
          },
          {
            "id": "j",
            "op": "join",
            "inputs": ["side_a_tbl", "side_b_tbl"],
            "output": "final",
            "params": {
              "left_keys": ["entity_id"],
              "right_keys": ["entity_id"],
              "how": "inner"
            }
          }
        ],
        "final_output": "final",
        "final_output_requirements": {
          "grain": "entity",
          "required_columns": ["entity_id", "side_a", "side_b"],
          "output_roles": [
            {"role": "entity_key", "columns": ["entity_id"]},
            {"role": "comparison_side", "columns": ["side_a"], "side_id": "A"},
            {"role": "comparison_side", "columns": ["side_b"], "side_id": "B"}
          ]
        }
      }
    },
